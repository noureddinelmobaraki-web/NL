{
  "name": "nl-noureddin-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "prebuild": "node scripts/generate-sw-version.js",
    "build": "node scripts/verify-lrc.mjs && node scripts/hash.mjs --write && vite build --emptyOutDir && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node scripts/generate-sitemap.mjs",
    "start": "node dist/server.cjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "preview": "vite preview",
    "analyze": "vite build --mode analyze",
    "clean": "rm -rf dist",
    "hash:csp": "node scripts/hash.mjs",
    "lint": "tsc --noEmit",
    "generate:posters": "node scripts/generate-posters.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emailjs/browser": "4.4.1",
    "@fontsource/bangers": "^5.2.8",
    "@fontsource/comic-neue": "^5.2.7",
    "@fontsource/patrick-hand": "^5.2.8",
    "@fontsource/share-tech-mono": "^5.2.7",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "8.5.2",
    "framer-motion": "^12.0.0",
    "hls.js": "1.6.16",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "terser": "5.47.1",
    "three": "0.184.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.184.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "0.28.0",
    "jsdom": "29.1.1",
    "p-limit": "^7.3.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "vitest": "4.1.7"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10"
}
