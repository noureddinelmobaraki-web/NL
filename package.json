{
  "name": "nl-noureddin-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build:client && npm run build:server && npm run build:sitemap",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:sitemap": "node scripts/generate-sitemap.mjs",
    "prebuild": "npm run prebuild:sw && npm run prebuild:lrc && npm run prebuild:csp",
    "prebuild:sw": "node scripts/generate-sw-version.js",
    "prebuild:lrc": "node scripts/verify-lrc.mjs",
    "prebuild:csp": "node scripts/hash.mjs --write",
    "start": "node dist/server.cjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "preview": "vite preview",
    "analyze": "vite build --mode analyze",
    "clean": "rm -rf dist",
    "hash:csp": "node scripts/hash.mjs",
    "lint": "tsc --noEmit && eslint src --max-warnings=0",
    "lint:ts": "tsc --noEmit",
    "lint:eslint": "eslint src --max-warnings=0",
    "generate:posters": "node scripts/generate-posters.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emailjs/browser": "4.4.1",
    "@fontsource/bangers": "^5.2.8",
    "@fontsource/comic-neue": "^5.2.7",
    "@fontsource/patrick-hand": "^5.2.8",
    "@fontsource/share-tech-mono": "^5.2.7",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "0.28.0",
    "express": "5.2.1",
    "framer-motion": "^12.0.0",
    "hls.js": "1.6.16",
    "lucide-react": "^0.546.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.14",
    "terser": "5.47.1",
    "typescript": "~5.9.0",
    "vite": "^6.0.0",
    "web-vitals": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "29.1.1",
    "p-limit": "^7.3.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "tsx": "4.22.4",
    "typescript-eslint": "^8.20.0",
    "vitest": "4.1.7"
  },
  "engines": {
    "node": ">=20"
  }
}
