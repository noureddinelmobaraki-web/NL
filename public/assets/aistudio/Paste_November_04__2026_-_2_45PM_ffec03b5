# PHASE 1 — Isolated playback clock + iframe bridge + honest player controls

## Problem
The cinema player shows its own progress bar / ±10s / play-pause, but when the movie runs inside a cross-origin <iframe> those controls cannot control it (browser security). The bar is a fake clock, so subtitles drift. Also `videoCurrentTime` state updates 4×/s at the root of MoviesPage.tsx (≈4,600 lines), re-rendering everything.

## Goal
Three control modes:
- "direct": playerRenderMode === "direct" (<video> + HLS.js) → full control (seek, ±10s, play/pause).
- "bridged": iframe whose player posts time events via postMessage (origin-allowlisted) → subtitles follow the REAL time; bar becomes read-only; seek/±10s/play-pause hidden.
- "none": iframe without events → hide the fake progress bar and ±10s/play-pause; show a clearly labelled "Subtitle clock" (start/pause, scrub, offset). Auto-start the subtitle clock on the user's first click into the iframe.

## 1.1 Create `src/features/cinema/player/playbackClock.ts`
```ts
import { useEffect, useState, useSyncExternalStore } from "react";

export type ClockSource = "none" | "video" | "bridge" | "manual";

export interface ClockState {
  anchorTime: number;
  anchorAt: number;
  duration: number;
  paused: boolean;
  rate: number;
  source: ClockSource;
}

const initial = (source: ClockSource = "none"): ClockState => ({
  anchorTime: 0,
  anchorAt: performance.now(),
  duration: 0,
  paused: true,
  rate: 1,
  source,
});

let state: ClockState = initial();
const listeners = new Set<() => void>();

function emit(next: ClockState) {
  state = next;
  listeners.forEach((l) => l());
}

/** Current media time (seconds), interpolated between events. Cheap: call it inside rAF. */
export function clockNow(): number {
  if (state.paused) return state.anchorTime;
  return Math.max(0, state.anchorTime + ((performance.now() - state.anchorAt) / 1000) * state.rate);
}

export const clockGetState = (): ClockState => state;

export function clockSubscribe(listener: () => void): () => void {
  listeners.add(listener);
  return () => {
    listeners.delete(listener);
  };
}

export interface ClockSyncInput {
  time?: number;
  paused?: boolean;
  duration?: number;
  rate?: number;
  source?: ClockSource;
}

export function clockSync(input: ClockSyncInput): void {
  const time =
    typeof input.time === "number" && Number.isFinite(input.time) ? Math.max(0, input.time) : clockNow();
  const duration =
    typeof input.duration === "number" && Number.isFinite(input.duration) && input.duration > 0
      ? input.duration
      : state.duration;
  emit({
    anchorTime: time,
    anchorAt: performance.now(),
    duration,
    paused: input.paused ?? state.paused,
    rate: input.rate ?? state.rate,
    source: input.source ?? state.source,
  });
}

/** Re-anchor only on drift/state change (avoids renders on periodic timeupdate). */
export function clockSoftSync(time: number, extra: Omit<ClockSyncInput, "time"> = {}, toleranceSec = 0.35): void {
  const pausedChanged = extra.paused !== undefined && extra.paused !== state.paused;
  const durationChanged = extra.duration !== undefined && Math.abs((extra.duration || 0) - state.duration) > 1;
  const sourceChanged = extra.source !== undefined && extra.source !== state.source;
  if (pausedChanged || durationChanged || sourceChanged || Math.abs(clockNow() - time) > toleranceSec) {
    clockSync({ ...extra, time });
  }
}

export const clockPlay = () => {
  if (state.paused) clockSync({ paused: false });
};
export const clockPause = () => {
  if (!state.paused) clockSync({ time: clockNow(), paused: true });
};
export const clockSeek = (t: number) => clockSync({ time: t });
export const clockReset = (source: ClockSource = "none") => emit(initial(source));

export function useClockState(): ClockState {
  return useSyncExternalStore(clockSubscribe, clockGetState, clockGetState);
}

/** Low-frequency time for labels/progress bars. Re-renders ONLY the component using it. */
export function useClockTime(intervalMs = 250): number {
  const s = useClockState();
  const [t, setT] = useState(() => clockNow());
  useEffect(() => {
    setT(clockNow());
    if (s.paused) return undefined;
    const id = window.setInterval(() => setT(clockNow()), intervalMs);
    return () => window.clearInterval(id);
  }, [s, intervalMs]);
  return t;
}

/** Drive the clock from a real <video>. Returns cleanup. */
export function bindVideoElementToClock(video: HTMLVideoElement): () => void {
  const push = (paused?: boolean) =>
    clockSync({
      time: video.currentTime,
      duration: video.duration,
      paused: paused ?? video.paused,
      rate: video.playbackRate,
      source: "video",
    });
  const onTime = () =>
    clockSoftSync(video.currentTime, { paused: video.paused, duration: video.duration, source: "video" }, 0.25);
  const handlers: Array<[string, EventListener]> = [
    ["timeupdate", onTime],
    ["playing", () => push(false)],
    ["play", () => push(false)],
    ["pause", () => push(true)],
    ["waiting", () => push(true)],
    ["ended", () => push(true)],
    ["seeked", () => push()],
    ["ratechange", () => push()],
    ["loadedmetadata", () => push()],
    ["durationchange", () => push()],
  ];
  handlers.forEach(([n, f]) => video.addEventListener(n, f));
  push();
  return () => handlers.forEach(([n, f]) => video.removeEventListener(n, f));
}
```

## 1.2 Create `src/features/cinema/player/iframeBridge.ts`
```ts
import { useEffect, useRef, useState, type RefObject } from "react";
import { clockSoftSync, clockSync } from "./playbackClock";

export type BridgeKind = "timeupdate" | "play" | "pause" | "seeked" | "ended" | "media";
export interface BridgeEvent {
  kind: BridgeKind;
  currentTime?: number;
  duration?: number;
  payload?: unknown;
}

const num = (v: unknown): number | undefined => {
  const n = typeof v === "string" ? parseFloat(v) : v;
  return typeof n === "number" && Number.isFinite(n) ? n : undefined;
};

const KIND_MAP: Record<string, BridgeKind> = {
  timeupdate: "timeupdate", time: "timeupdate", progress: "timeupdate",
  play: "play", playing: "play", pause: "pause", paused: "pause",
  seeked: "seeked", seeking: "seeked", seek: "seeked", ended: "ended", complete: "ended",
};

export function parsePlayerMessage(raw: unknown): BridgeEvent | null {
  let d: any = raw;
  if (typeof d === "string") {
    if (!d.trim().startsWith("{")) return null;
    try { d = JSON.parse(d); } catch { return null; }
  }
  if (!d || typeof d !== "object") return null;

  // VidLink (documented): { type: "PLAYER_EVENT", data: { event, currentTime, duration, ... } }
  if (d.type === "PLAYER_EVENT" && d.data && typeof d.data === "object") {
    return {
      kind: KIND_MAP[String(d.data.event || "").toLowerCase()] ?? "timeupdate",
      currentTime: num(d.data.currentTime),
      duration: num(d.data.duration),
      payload: d.data,
    };
  }
  if (d.type === "MEDIA_DATA") return { kind: "media", payload: d.data };

  // Generic best-effort shapes (still origin-gated by the caller).
  const inner = d.data && typeof d.data === "object" ? d.data : d;
  const t = num(inner.currentTime ?? inner.time ?? inner.position);
  if (t === undefined) return null;
  const evName = String(inner.event ?? d.event ?? "timeupdate").toLowerCase();
  return { kind: KIND_MAP[evName] ?? "timeupdate", currentTime: t, duration: num(inner.duration) };
}

/** True if `source` is the iframe window or one of its direct child frames. */
function isFromFrame(source: MessageEventSource | null, root: Window | null | undefined): boolean {
  if (!source || !root) return false;
  if (source === root) return true;
  try {
    for (let i = 0; i < root.frames.length; i += 1) {
      if (root.frames[i] === source) return true;
    }
  } catch { /* cross-origin frames access can throw in some browsers */ }
  return false;
}

export function useIframePlayerBridge(opts: {
  iframeRef: RefObject<HTMLIFrameElement | null>;
  allowedOrigins: string[];
  enabled: boolean;
  onMediaData?: (payload: unknown) => void;
}): boolean {
  const [active, setActive] = useState(false);
  const onMediaRef = useRef(opts.onMediaData);
  onMediaRef.current = opts.onMediaData;
  const originsKey = opts.allowedOrigins.join("|");
  const { iframeRef, enabled } = opts;

  useEffect(() => {
    setActive(false);
    if (!enabled) return undefined;
    const allowed = new Set(originsKey.split("|").filter(Boolean));

    const onMessage = (e: MessageEvent) => {
      if (!allowed.has(e.origin)) return;
      if (!isFromFrame(e.source, iframeRef.current?.contentWindow)) return;
      const ev = parsePlayerMessage(e.data);
      if (!ev) return;
      if (ev.kind === "media") { onMediaRef.current?.(ev.payload); return; }
      if (ev.currentTime === undefined) return;
      setActive(true);
      if (ev.kind === "timeupdate") {
        clockSoftSync(ev.currentTime, { paused: false, duration: ev.duration, source: "bridge" });
      } else {
        clockSync({
          time: ev.currentTime,
          duration: ev.duration,
          paused: ev.kind === "pause" || ev.kind === "ended" ? true : ev.kind === "play" ? false : undefined,
          source: "bridge",
        });
      }
    };
    window.addEventListener("message", onMessage);
    return () => window.removeEventListener("message", onMessage);
  }, [enabled, originsKey, iframeRef]);

  return active;
}
```

