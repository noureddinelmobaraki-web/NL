import React from "react";
import { Pause, Play, RotateCcw, RotateCw, Timer } from "lucide-react";
import { useTranslation } from "react-i18next";
import { clockPause, clockPlay, clockSeek, useClockState, useClockTime } from "./playbackClock";

export type PlayerControlMode = "direct" | "bridged" | "none";

export const formatClock = (s: number): string => {
  const v = Number.isFinite(s) && s > 0 ? s : 0;
  const h = Math.floor(v / 3600);
  const m = String(Math.floor((v % 3600) / 60)).padStart(2, "0");
  const sec = String(Math.floor(v % 60)).padStart(2, "0");
  return h ? `${h}:${m}:${sec}` : `${m}:${sec}`;
};

const pill = "lg-cinema-action-pill h-8 px-3 rounded-full text-[11px] font-bold text-white flex items-center gap-1 cursor-pointer";

export const CinemaTimeline = React.memo(function CinemaTimeline({
  mode,
  videoRef,
  fallbackDurationSec = 0,
  hasSubtitles,
}: {
  mode: PlayerControlMode;
  videoRef: React.RefObject<HTMLVideoElement | null>;
  fallbackDurationSec?: number;
  hasSubtitles: boolean;
}) {
  const { t } = useTranslation();
  const time = useClockTime(250);
  const clock = useClockState();
  const duration = clock.duration || fallbackDurationSec;
  const pct = duration > 0 ? Math.min(100, (time / duration) * 100) : 0;

  if (mode === "direct") {
    const v = videoRef.current;
    return (
      <div className="flex flex-col gap-1.5 w-full" dir="ltr">
        <div className="flex items-center gap-2 text-[10px] font-bold text-white/80">
          <span>{formatClock(time)}</span>
          <input
            type="range" min={0} max={duration || 0} step={0.5} value={Math.min(time, duration || 0)}
            onChange={(e) => { const el = videoRef.current; if (el) el.currentTime = Number(e.target.value); }}
            className="flex-1 accent-red-600 cursor-pointer"
            aria-label={t("movies.player.seek", "Seek")}
          />
          <span>{formatClock(duration)}</span>
        </div>
        <div className="flex items-center gap-2">
          <button type="button" className={pill} onClick={() => (v?.paused ? v.play() : v?.pause())}>
            {clock.paused ? <Play size={13} /> : <Pause size={13} />}
          </button>
          <button type="button" className={pill} onClick={() => { if (v) v.currentTime = Math.max(0, v.currentTime - 10); }}>
            <RotateCcw size={12} /> 10s
          </button>
          <button type="button" className={pill} onClick={() => { if (v) v.currentTime = v.currentTime + 10; }}>
            <RotateCw size={12} /> 10s
          </button>
        </div>
      </div>
    );
  }

  if (mode === "bridged") {
    return (
      <div className="flex items-center gap-2 w-full text-[10px] font-bold text-white/80" dir="ltr">
        <span>{formatClock(time)}</span>
        <div className="relative flex-1 h-1 rounded-full bg-white/15 overflow-hidden" aria-hidden="true">
          <div className="absolute inset-y-0 left-0 bg-red-600" style={{ width: `${pct}%` }} />
        </div>
        <span>{formatClock(duration)}</span>
        <span className="px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 text-[9px]">
          {t("movies.player.synced", "Synced with player")}
        </span>
      </div>
    );
  }

  if (!hasSubtitles) return null;
  return (
    <div className="flex items-center gap-2 w-full text-[10px] font-bold text-white/85" dir="ltr">
      <span className="flex items-center gap-1 text-amber-300">
        <Timer size={12} /> {t("movies.subs.clock", "Subtitle clock")}
      </span>
      <button type="button" className={pill} onClick={() => (clock.paused ? clockPlay() : clockPause())}
        title={t("movies.subs.clockHint", "The movie player is separate. Start/pause this clock together with the movie.")}>
        {clock.paused ? <Play size={12} /> : <Pause size={12} />}
      </button>
      <span>{formatClock(time)}</span>
      <input
        type="range" min={0} max={duration || 10800} step={1} value={time}
        onChange={(e) => clockSeek(Number(e.target.value))}
        className="flex-1 accent-amber-400 cursor-pointer"
        aria-label={t("movies.subs.clockSeek", "Move subtitle clock")}
      />
      <span>{formatClock(duration)}</span>
    </div>
  );
});
```

