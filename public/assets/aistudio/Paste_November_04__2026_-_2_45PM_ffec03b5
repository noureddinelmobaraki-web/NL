# PHASE 3 — Cloudflare Worker routes (hide Wyzie key, IMDb trailer lookup)

The Worker `https://broad-block-7bd7.nordinegb2018.workers.dev/` is probably NOT in this repo. Check first (search for a wrangler.toml or worker folder). If it is absent, create `cloudflare/nl-routes.js` with the code below plus a `cloudflare/README.md` telling the owner to paste it into the existing worker, call it at the very top of `fetch()`, and add the secret `WYZIE_KEY` (Dashboard → Worker → Settings → Variables → Secret). Do NOT modify the existing POST `/` and `/proxy` behaviour.

```js
// cloudflare/nl-routes.js
// Usage inside the existing worker:
//   const nl = await handleNlRoutes(request, env, ctx); if (nl) return nl;
const WYZIE_BASE = "https://sub.wyzie.io";
const CORS = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Methods": "GET, OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type",
};

function json(body, status = 200, maxAge = 0) {
  return new Response(JSON.stringify(body), {
    status,
    headers: {
      "Content-Type": "application/json; charset=utf-8",
      "Cache-Control": maxAge ? `public, max-age=${maxAge}` : "no-store",
      ...CORS,
    },
  });
}

export async function handleNlRoutes(request, env, ctx) {
  const url = new URL(request.url);
  const p = url.pathname;
  if (!p.startsWith("/subs/") && !p.startsWith("/trailer/")) return null;
  if (request.method === "OPTIONS") return new Response(null, { status: 204, headers: CORS });
  if (request.method !== "GET") return json({ error: "method_not_allowed" }, 405);

  const cache = caches.default;
  const cacheKey = new Request(url.toString(), { method: "GET" });
  const cached = await cache.match(cacheKey);
  if (cached) return cached;

  let res;
  try {
    if (p === "/subs/search") res = await wyzieSearch(url, env);
    else if (p === "/subs/file") res = await wyzieFile(url, env);
    else if (p === "/trailer/imdb") res = await imdbTrailer(url);
    else res = json({ error: "not_found" }, 404);
  } catch (err) {
    res = json({ error: "upstream_failed", detail: String((err && err.message) || err) }, 502);
  }
  if (res.ok && ctx && ctx.waitUntil) ctx.waitUntil(cache.put(cacheKey, res.clone()));
  return res;
}

async function wyzieSearch(url, env) {
  if (!env.WYZIE_KEY) return json({ error: "missing_key" }, 500);
  const up = new URL(`${WYZIE_BASE}/search`);
  for (const k of ["id", "language", "season", "episode", "format", "source"]) {
    const v = url.searchParams.get(k);
    if (v) up.searchParams.set(k, v.slice(0, 200));
  }
  if (!/^(tt\d{5,10}|\d{1,9})$/.test(up.searchParams.get("id") || "")) return json({ error: "bad_id" }, 400);
  up.searchParams.set("key", env.WYZIE_KEY);
  const r = await fetch(up.toString(), { headers: { Accept: "application/json" } });
  if (r.status === 404) return json([], 200, 1800);
  if (!r.ok) return json({ error: `wyzie_${r.status}` }, 502);
  const data = await r.json();
  const list = Array.isArray(data) ? data : data.subtitles || data.results || [];
  const rewritten = list.map((item) => {
    if (!item || typeof item.url !== "string") return item;
    try {
      const u = new URL(item.url);
      u.searchParams.delete("key");
      const prox = new URL("/subs/file", url.origin);
      prox.searchParams.set("url", u.toString());
      return { ...item, url: prox.toString() };
    } catch {
      return item;
    }
  });
  return json(rewritten, 200, 3600);
}

async function wyzieFile(url, env) {
  let u;
  try { u = new URL(url.searchParams.get("url") || ""); } catch { return json({ error: "bad_url" }, 400); }
  if (u.protocol !== "https:" || u.hostname !== "sub.wyzie.io") return json({ error: "host_not_allowed" }, 403);
  if (env.WYZIE_KEY) u.searchParams.set("key", env.WYZIE_KEY);
  const r = await fetch(u.toString());
  if (!r.ok) return json({ error: `wyzie_${r.status}` }, 502);
  return new Response(r.body, {
    status: 200,
    headers: {
      "Content-Type": r.headers.get("Content-Type") || "text/plain; charset=utf-8",
      "Cache-Control": "public, max-age=86400",
      ...CORS,
    },
  });
}

// Unofficial: IMDb has no free API and uses AWS WAF; this may stop working at any time.
async function imdbTrailer(url) {
  const id = url.searchParams.get("id") || "";
  if (!/^tt\d{5,10}$/.test(id)) return json({ error: "bad_id" }, 400);
  const r = await fetch(`https://www.imdb.com/title/${id}/`, {
    headers: {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36",
      Accept: "text/html,application/xhtml+xml",
      "Accept-Language": "en-US,en;q=0.9",
    },
  });
  if (!r.ok) return json({ error: `imdb_${r.status}` }, 404);
  const html = await r.text();
  const match = html.match(/\/video\/(vi\d{6,12})/);
  if (!match) return json({ error: "no_video" }, 404);
  const videoId = match[1];
  return json({ source: "imdb", videoId, embedUrl: `https://www.imdb.com/video/embed/${videoId}/` }, 200, 604800);
}
