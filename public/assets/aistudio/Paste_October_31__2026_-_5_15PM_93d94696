const VERTEX_SHADER_SOURCE = `
  attribute vec2 a_position;
  attribute vec2 a_texCoord;
  varying vec2 v_texCoord;

  void main() {
    gl_Position = vec4(a_position, 0.0, 1.0);
    v_texCoord = a_texCoord;
  }
`;

function buildFragmentShaderSource(hasDerivatives: boolean): string {
  const gradientBlock = hasDerivatives
    ? `
      #ifdef GL_OES_standard_derivatives
      vec2 grad = normalize(vec2(dFdx(sdf), dFdy(sdf)) + vec2(1e-5));
      #else
      vec2 grad = normalize(vec2(0.1, 0.1));
      #endif
    `
    : `
      float eps = 2.0;
      vec2 h = vec2(eps, 0.0);
      float sdf1 = sdRoundedRect((fragCoord + h.xy) - u_center, vec2(u_width, u_height), vec4(u_cornerRadius));
      float sdf2 = sdRoundedRect((fragCoord - h.xy) - u_center, vec2(u_width, u_height), vec4(u_cornerRadius));
      float sdf3 = sdRoundedRect((fragCoord + h.yx) - u_center, vec2(u_width, u_height), vec4(u_cornerRadius));
      float sdf4 = sdRoundedRect((fragCoord - h.yx) - u_center, vec2(u_width, u_height), vec4(u_cornerRadius));
      vec2 grad = normalize(vec2(sdf1 - sdf2, sdf3 - sdf4) + vec2(1e-5));
    `;

  return `
    #ifdef GL_OES_standard_derivatives
    #extension GL_OES_standard_derivatives : enable
    #endif

    #ifdef GL_FRAGMENT_PRECISION_HIGH
    precision highp float;
    #else
    precision mediump float;
    #endif

    uniform float u_time;
    uniform vec2 u_resolution;
    uniform vec2 u_center;
    uniform vec2 u_lightShift;
    uniform sampler2D u_texture;
    uniform float u_width;
    uniform float u_height;
    uniform vec3 u_tint;
    uniform float u_saturation;
    uniform float u_distortion;
    uniform float u_blur;
    uniform float u_imageAspect;
    uniform float u_canvasAspect;
    uniform float u_shadowIntensity;
    uniform vec2 u_shadowOffset;
    uniform float u_shadowBlur;
    uniform float u_cornerRadius;
    uniform float u_chromaticAberration;

    varying vec2 v_texCoord;

    vec2 getCoverUV(vec2 uv, float imageAspect, float canvasAspect) {
      vec2 coverUV = uv;
      if (imageAspect > canvasAspect) {
        float scale = canvasAspect / max(imageAspect, 0.0001);
        coverUV.x = (uv.x - 0.5) * scale + 0.5;
      } else {
        float scale = imageAspect / max(canvasAspect, 0.0001);
        coverUV.y = (uv.y - 0.5) * scale + 0.5;
      }
      return clamp(coverUV, 0.001, 0.999);
    }

    float sdRoundedRect(vec2 pos, vec2 halfSize, vec4 cornerRadius) {
      cornerRadius.xy = (pos.x > 0.0) ? cornerRadius.xy : cornerRadius.zw;
      cornerRadius.x = (pos.y > 0.0) ? cornerRadius.x : cornerRadius.y;
      vec2 q = abs(pos) - halfSize + cornerRadius.x;
      return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - cornerRadius.x;
    }

    vec2 randomVec2(vec2 co) {
      return fract(sin(vec2(
        dot(co, vec2(127.1, 311.7)),
        dot(co, vec2(269.5, 183.3))
      )) * 43758.5453);
    }

    vec3 sampleWithChromaticAberration(vec2 uv, float timeOffset, float mipLevel, float aberrationStrength) {
      vec2 coverUV = getCoverUV(uv, u_imageAspect, u_canvasAspect);
      vec2 offset = randomVec2(coverUV + vec2(u_time * 0.15 + timeOffset)) / max(u_resolution.x, 1.0);
      vec2 noiseOffset = offset * pow(2.0, mipLevel) * 0.008;

      if (aberrationStrength <= 0.0) {
        return texture2D(u_texture, clamp(coverUV + noiseOffset, 0.001, 0.999)).rgb;
      }

      vec2 center = vec2(0.5);
      vec2 delta = coverUV - center;
      float dist = length(delta);
      vec2 dir = dist > 0.0001 ? (delta / dist) : vec2(0.0);
      float abOffset = aberrationStrength * dist * 0.008;

      float r = texture2D(u_texture, clamp(coverUV + dir * abOffset * 1.2 + noiseOffset, 0.001, 0.999)).r;
      float g = texture2D(u_texture, clamp(coverUV + noiseOffset, 0.001, 0.999)).g;
      float b = texture2D(u_texture, clamp(coverUV - dir * abOffset * 0.8 + noiseOffset, 0.001, 0.999)).b;
      return vec3(r, g, b);
    }

    vec3 getBlurredColor(vec2 uv, float mipLevel) {
      return (
        sampleWithChromaticAberration(uv, 0.00, mipLevel, u_chromaticAberration) +
        sampleWithChromaticAberration(uv, 0.25, mipLevel, u_chromaticAberration) +
        sampleWithChromaticAberration(uv, 0.50, mipLevel, u_chromaticAberration) +
        sampleWithChromaticAberration(uv, 0.75, mipLevel, u_chromaticAberration) +
        sampleWithChromaticAberration(uv, 1.00, mipLevel, u_chromaticAberration) +
        sampleWithChromaticAberration(uv, 1.25, mipLevel, u_chromaticAberration) +
        sampleWithChromaticAberration(uv, 1.50, mipLevel, u_chromaticAberration) +
        sampleWithChromaticAberration(uv, 1.75, mipLevel, u_chromaticAberration) +
        sampleWithChromaticAberration(uv, 2.00, mipLevel, u_chromaticAberration)
      ) * 0.1111111;
    }

    vec3 saturateColor(vec3 color, float factor) {
      float gray = dot(color, vec3(0.299, 0.587, 0.114));
      return mix(vec3(gray), color, factor);
    }

    void main() {
      vec2 fragCoord = v_texCoord * u_resolution;
      vec2 centeredUV = fragCoord - u_center;
      float sdf = sdRoundedRect(centeredUV, vec2(u_width, u_height), vec4(u_cornerRadius));

      vec2 coverUV = getCoverUV(v_texCoord, u_imageAspect, u_canvasAspect);
      vec3 baseTex = texture2D(u_texture, coverUV).rgb;

      // Analytical O(1) soft drop shadow around the rounded glass frame (60fps on mobile)
      float shadowDist = sdRoundedRect(centeredUV - u_shadowOffset, vec2(u_width, u_height), vec4(u_cornerRadius));
      float shadowAlpha = (1.0 - smoothstep(-u_shadowBlur * 0.35, max(u_shadowBlur, 1.0), shadowDist)) * u_shadowIntensity;
      vec3 shadowedBackground = baseTex * (1.0 - shadowAlpha);

      // Fast exit outside the glass boundary -> saves ~75% GPU fragment bandwidth
      if (sdf > 1.5) {
        gl_FragColor = vec4(shadowedBackground, 1.0);
        return;
      }

      float minHalfDim = max(min(u_width, u_height), 1.0);
      float normalizedInside = clamp((sdf / minHalfDim) + 1.0, 0.0, 1.0);
      float edgeBlendFactor = pow(normalizedInside, 10.0);

      ${gradientBlock}

      float refractAmount = edgeBlendFactor * -0.045 * u_distortion;
      vec2 sampleUV = v_texCoord + grad * refractAmount + u_lightShift * 0.004 * edgeBlendFactor;
      float mipLevel = mix(3.2 * u_blur, 1.35, edgeBlendFactor);

      vec3 glassTex = getBlurredColor(sampleUV, mipLevel);
      glassTex = mix(glassTex, pow(max(saturateColor(glassTex, u_saturation), vec3(0.0)), vec3(0.72)), edgeBlendFactor * 0.65);
      glassTex *= u_tint;

      // Specular edge reflection + subtle pointer light response
      vec2 lightDir = normalize(vec2(-0.707, -0.707) + u_lightShift * 0.35);
      float spec = 1.0 - clamp(pow(1.0 - abs(dot(grad, lightDir)), 0.55), 0.0, 1.0);
      glassTex += mix(0.0, 0.34, clamp(spec * pow(edgeBlendFactor, 3.6), 0.0, 1.0));

      // Crisp inner rim highlight
      float rim = smoothstep(-3.0, -0.4, sdf) * (1.0 - smoothstep(-0.4, 1.2, sdf));
      glassTex += vec3(rim * 0.26);

      float boxMask = 1.0 - smoothstep(-0.75, 0.75, sdf);
      gl_FragColor = vec4(mix(shadowedBackground, glassTex, boxMask), 1.0);
    }
  `;
}

// ============================================================================
// Helper: Format seconds into MM:SS (or HH:MM:SS)
// ============================================================================
function formatDuration(sec: number): string {
  if (!Number.isFinite(sec) || sec < 0) return '00:00';
  const total = Math.floor(sec);
  const hrs = Math.floor(total / 3600);
  const mins = Math.floor((total % 3600) / 60);
  const secs = total % 60;
  const mm = String(mins).padStart(2, '0');
  const ss = String(secs).padStart(2, '0');
  return hrs > 0 ? `${hrs}:${mm}:${ss}` : `${mm}:${ss}`;
}

