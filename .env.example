# EmailJS Configuration
# These use VITE_ prefix so Vite compiles them into the client bundle.
# The public key is safe for client-side use by design.
VITE_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID_HERE
VITE_EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID_HERE
VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY_HERE
# WARNING: EMAILJS_PRIVATE_KEY must NEVER use VITE_ prefix.
# It is a server-side secret only. This static site does not use it — leave empty.
# EMAILJS_PRIVATE_KEY=

# Sentry Monitoring Configuration
VITE_SENTRY_DSN=
VITE_APP_VERSION=dev

# Google reCAPTCHA v2 site key (public — safe for client). Secret key goes ONLY in the EmailJS template settings.
VITE_RECAPTCHA_SITE_KEY=

# TMDB (مجاني: themoviedb.org/settings/api → API Key v3 auth)
VITE_TMDB_API_KEY=
# OMDb لتقييم IMDb (مجاني: omdbapi.com/apikey.aspx)
VITE_OMDB_API_KEY=

# Supabase (backend for music likes/comments).
# The anon key is a PUBLIC client key protected by Row Level Security — safe to
# expose in the client bundle. Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
